# ==============================================================================
# KAPDE — Environment Variables Configuration
# Copy this file to .env.local and update with your actual credentials
# ==============================================================================

# Supabase Configuration
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Whitelist & Security
# Comma-separated list of approved Google OAuth emails
ADMIN_EMAILS=owner@kapde.com,admin@kapde.com
# Fallback local/dev admin password
ADMIN_PASSWORD=kapde_admin_secure_2026
# Secret for signing admin session cookies (32+ character random string)
ADMIN_SESSION_SECRET=super_secret_session_signing_key_32_chars_min

# WhatsApp & Commerce Configuration
# International format without + or spaces (e.g., 919876543210 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_SITE_URL=http://localhost:3000
